---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer surface-dark on-dark">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <a href="/" class="site-footer__brand">
        <span class="site-footer__mark" aria-hidden="true"></span>
        <span>{site.name}</span>
      </a>
      <p class="site-footer__blurb">
        Sourced information about routine infant circumcision, written for
        parents. Educational only — not medical advice.
      </p>
    </div>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/evidence">Evidence</a>
      <a href="/faq">Common claims</a>
      <a href="/history">History</a>
      <a href="/take-action">Take action</a>
      <a href="/resources">Resources</a>
    </nav>
    <p class="site-footer__copy">&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    padding-block: var(--space-8);
    font-size: var(--step--1);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-footer__about {
    max-width: 26rem;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--color-paper);
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .site-footer__brand:hover,
  .site-footer__brand:focus-visible {
    color: #fff;
  }

  .site-footer__mark {
    width: 16px;
    height: 16px;
    border: 2.5px solid rgba(250, 248, 244, 0.8);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .site-footer__blurb {
    margin: 0;
    line-height: 1.6;
    color: rgba(250, 248, 244, 0.75);
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__links a {
    color: rgba(250, 248, 244, 0.85);
    text-decoration: none;
    transition: color var(--transition);
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer__copy {
    margin: 0;
    align-self: flex-end;
    color: rgba(250, 248, 244, 0.6);
  }

  @media (max-width: 39.99rem) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .site-footer__copy { align-self: flex-start; }
  }
</style>
