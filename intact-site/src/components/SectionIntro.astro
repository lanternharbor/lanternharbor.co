---
interface Props {
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { eyebrow, heading, lede } = Astro.props;
---

<header class="section-intro">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="section-intro__heading">{heading}</h2>
  {lede && <p class="section-intro__lede">{lede}</p>}
</header>

<style>
  .section-intro {
    max-width: var(--measure-intro);
    margin-bottom: var(--space-6);
  }

  .section-intro__heading {
    margin: 0 0 var(--space-3);
    font-size: var(--step-3);
    line-height: 1.2;
  }

  .section-intro__lede {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--color-body);
  }
</style>
