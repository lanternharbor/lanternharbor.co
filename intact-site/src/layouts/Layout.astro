---
// Self-hosted fonts — no requests to fonts.googleapis.com.
import '@fontsource/lora/400.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  pageKey?: string;
  noindex?: boolean;
}

const { title, description, pageKey, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = pageKey === 'home' ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;

const siteURL = Astro.site?.toString() ?? site.url;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}#website`,
  name: site.name,
  description: site.description,
  url: siteURL,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#1E4B43" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Whole From the Start — healthy children are born whole" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/social-card.png', Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Lora (headings) + Inter (body) — self-hosted via @fontsource (see frontmatter). -->

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Structured data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
